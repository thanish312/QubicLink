# --- Discord Bot Credentials ---
# The token for your Discord bot. Get this from the Discord Developer Portal.
DISCORD_TOKEN=
# The client ID of your Discord application.
CLIENT_ID=
# The ID of the Discord server (guild) where you want to use the bot.
GUILD_ID=

# --- Admin Dashboard ---
# The password for the admin dashboard.
ADMIN_PASSWORD=
# A long, random secret for signing JWTs. Generate one from a password manager or CLI.
ADMIN_JWT_SECRET=
# The full URL where the frontend is hosted (e.g., http://localhost:3000 for development).
FRONTEND_URL=http://localhost:3000
# The logging level for the application. Options: 'debug', 'info', 'warn', 'error'.
LOG_LEVEL=info

# --- Database ---
# The connection URL for your PostgreSQL database. This single URL contains all the necessary information.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL=postgresql://user:password@db:5432/qubiclink?schema=public